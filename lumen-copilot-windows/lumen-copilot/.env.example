# Default: fully offline, deterministic rules engine (no API key needed).
LUMEN_AGENT_MODE=rules            # rules | hybrid | llm

# Optional LLM understanding layer (hybrid = LLM only for requests the rules can't ground).
# LUMEN_LLM_PROVIDER=groq         # openai | groq | openrouter | ollama | anthropic
# LUMEN_LLM_MODEL=llama-3.3-70b-versatile
# LUMEN_LLM_API_KEY=...
# LUMEN_LLM_BASE_URL=http://localhost:11434/v1   # for Ollama

# Optional dense embeddings in retrieval (pip install sentence-transformers)
# LUMEN_DENSE=1
